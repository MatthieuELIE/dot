{
  "permissions": {
    "allow": [
      "mcp__tokensave__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pr-body-no-test-plan.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/git-commit-format-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-main-branch-commits.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-bad-branch-name.sh\""
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/tokensave",
            "args": [
              "hook-pre-tool-use"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/tokensave",
            "args": [
              "hook-prompt-submit"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/tokensave",
            "args": [
              "hook-stop"
            ]
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "typescript-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "mattpocock-skills@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v4.8.4"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "theme": "dark"
}
